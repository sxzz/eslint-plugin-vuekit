{
  "name": "eslint-plugin-vuekit",
  "version": "11.0.0-beta.1",
  "description": "Modern ESLint plugin for Vue 3",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "new": "node tools/new-rule.ts",
    "start": "pnpm test:base --watch",
    "test:base": "vitest run --reporter=dot tests/lib",
    "test": "vitest run",
    "test:integrations": "vitest run tests/integrations",
    "debug": "vitest run --inspect --no-file-parallelism --reporter=dot tests/lib",
    "cover": "vitest run --coverage --reporter=dot tests/lib",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --cache && markdownlint \"**/*.md\"",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --cache --fix && markdownlint \"**/*.md\" --fix",
    "tsc": "tsc",
    "update": "node ./tools/update.ts",
    "update-resources": "node ./tools/update-resources.ts",
    "typegen": "node ./tools/generate-typegen.ts",
    "build": "pnpm typegen && tsdown",
    "docs:watch": "vitepress dev docs",
    "predocs:build": "pnpm run update",
    "docs:build": "vitepress build docs",
    "docs:deploy": "pnpm run docs:build && wrangler deploy",
    "generate:version": "node ./tools/update.ts --version && pnpm lint:fix",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://eslint-plugin-vuekit.sxzz.dev",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslint-config",
    "vue",
    "vuejs",
    "rules"
  ],
  "author": "Toru Nagashima (https://github.com/mysticatea)",
  "contributors": [
    "Michał Sajnóg <msajnog93@gmail.com> (https://github.com/michalsnik)",
    "Yosuke Ota (https://github.com/ota-meshi)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/eslint-plugin-vuekit.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/eslint-plugin-vuekit/issues"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "vue-eslint-parser": "^10.3.0"
  },
  "peerDependenciesMeta": {
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "natural-compare": "^1.4.0",
    "nth-check": "^3.0.1",
    "postcss-selector-parser": "^7.1.7",
    "verkit": "^0.5.0",
    "xml-name-validator": "^5.0.0"
  },
  "devDependencies": {
    "@eslint-community/regexpp": "^4.12.2",
    "@eslint/markdown": "^8.0.3",
    "@ota-meshi/site-kit-eslint-editor-vue": "^0.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/estree": "^1.0.10",
    "@types/natural-compare": "^1.4.3",
    "@types/node": "^26.6.6",
    "@types/xml-name-validator": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/scope-manager": "^8.72.1",
    "@typescript-eslint/types": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "assert": "^2.1.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-markdown-preferences": "^0.42.0",
    "eslint-plugin-node-dependencies": "^2.3.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-scope": "^9.1.2",
    "eslint-typegen": "^2.3.1",
    "eslint-visitor-keys": "^5.0.1",
    "espree": "^11.2.0",
    "esquery": "^1.7.0",
    "events": "^3.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "markdownlint-cli": "^0.50.0",
    "pathe": "^2.0.3",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.3",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vite": "^8.3.5",
    "vite-plugin-eslint4b": "^0.9.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.155.0"
  },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": {
    "access": "public"
  }
}
